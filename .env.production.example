# ============================================================
# Jombe CRM — Plantilla de Entorno para Despliegue en Producción (VPS)
# ============================================================

# --- Aplicación y Caddy --------------------------------------
# Dominio donde se publicará Jombe CRM (Caddy gestionará los certificados HTTPS automáticamente)
DOMAIN=crm.jombe.app
APP_BASE_URL=https://crm.jombe.app

# --- Autenticación y cookies ----------------------------------
# URL canónica de Better Auth. Si falta se usa APP_BASE_URL.
BETTER_AUTH_URL=https://crm.jombe.app
# Orígenes de confianza para CORS y CSRF, separados por coma.
BETTER_AUTH_TRUSTED_ORIGINS=https://crm.jombe.app,https://jombe.app,https://www.jombe.app,https://api.jombe.app
# Dominio padre de la cookie de sesión, para que la sesión viaje entre
# crm.jombe.app y la landing. Déjalo VACÍO si solo sirves el CRM en su host.
AUTH_COOKIE_DOMAIN=.jombe.app

# --- Base de Datos (PostgreSQL) ------------------------------
# Contraseña segura generada con: openssl rand -hex 24
POSTGRES_PASSWORD=cambiar_esta_contrasena_por_una_segura_24_caracteres
DATABASE_URL=postgresql://postgres:cambiar_esta_contrasena_por_una_segura_24_caracteres@postgres:5432/jombe

# --- Secretos de la Aplicación --------------------------------
# Firma de sesiones de usuario (mínimo 16 caracteres, generado con: openssl rand -base64 32)
BETTER_AUTH_SECRET=cambiar_por_secreto_de_sesion_aleatorio_32_bytes

# Clave de cifrado en reposo para credenciales (AES-256-GCM). DEBE ser de 32 bytes en Base64 (44 caracteres)
# Generado con: openssl rand -base64 32
ENCRYPTION_KEY=cambiar_por_clave_AES_256_GCM_de_32_bytes_base64_44chars=

# --- Proveedor 1: WhatsApp Meta Cloud API --------------------
# Token de verificación para el Webhook oficial de Meta Cloud API
# Generado con: openssl rand -hex 32
META_WEBHOOK_VERIFY_TOKEN=cambiar_por_token_de_verificacion_meta_32chars
# Opcional: App Secret de Meta para firma HMAC SHA-256
META_APP_SECRET=
META_GRAPH_API_VERSION=v25.0

# --- Proveedor 2: Evolution API (WhatsApp QR / Baileys) --------
# URL del servicio. En el despliegue propio es el subdominio dedicado;
# dentro de la red de Docker, el alias del contenedor.
EVOLUTION_API_URL=https://evoapi.jombe.app
# API Key global para autenticar solicitudes a Evolution API
EVOLUTION_API_KEY=cambiar_por_api_key_de_evolution_segura
# Instancia por defecto (se puede administrar también en la UI de Ajustes → WhatsApp)
EVOLUTION_INSTANCE=jombe_prod
# El webhook de la instancia debe apuntar a la app:
#   https://crm.jombe.app/api/webhooks/evolution

# --- Inteligencia Artificial (OpenRouter u OpenAI) ------------
# Opcional: Se puede configurar también directamente en el panel UI de Ajustes → IA
# Lo guardado en Ajustes → IA siempre tiene prioridad sobre estas variables.
OPENROUTER_API_TOKEN=
OPENROUTER_BASE_URL=https://openrouter.ai/api
OPENROUTER_MODEL=anthropic/claude-3.5-sonnet

# Pasarela propia compatible con OpenAI. Si están las DOS, mandan sobre las
# OPENROUTER_* como respaldo del entorno. El modelo se sigue tomando de
# OPENROUTER_MODEL y el nombre de la pasarela va tal cual, sin sufijo extra.
FREELLMAPI_BASE_URL=https://freellmapi.jombe.app/v1
FREELLMAPI_API_KEY=

# --- Configuración Operativa ----------------------------------
ALLOW_SIGNUP=false
AGENT_COALESCE_MS=6000
